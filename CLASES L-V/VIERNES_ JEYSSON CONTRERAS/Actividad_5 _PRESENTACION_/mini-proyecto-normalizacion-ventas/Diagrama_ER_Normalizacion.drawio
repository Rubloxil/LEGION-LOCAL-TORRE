<mxfile host="app.diagrams.net">
  <diagram name="ER_Normalizacion">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="cliente" value="CLIENTE&#10;PK cliente_doc&#10;cliente_nombre&#10;cliente_email&#10;cliente_telefono" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="120" width="180" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="vendedor" value="VENDEDOR&#10;PK vendedor_id&#10;vendedor_nombre&#10;vendedor_zona" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="320" width="180" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="venta" value="VENTA&#10;PK venta_id&#10;fecha_venta&#10;FK cliente_doc&#10;FK vendedor_id&#10;metodo_pago" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="200" width="190" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="detalle" value="DETALLE_VENTA&#10;PK detalle_id&#10;FK venta_id&#10;FK producto_codigo&#10;cantidad&#10;precio_unitario&#10;descuento" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="180" width="220" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="producto" value="PRODUCTO&#10;PK producto_codigo&#10;producto_nombre&#10;FK categoria_id" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="920" y="200" width="190" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="categoria" value="CATEGORIA&#10;PK categoria_id&#10;nombre_categoria" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1220" y="210" width="180" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="e1" value="1:N" edge="1" parent="1" source="cliente" target="venta">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e2" value="1:N" edge="1" parent="1" source="vendedor" target="venta">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e3" value="1:N" edge="1" parent="1" source="venta" target="detalle">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e4" value="1:N" edge="1" parent="1" source="producto" target="detalle">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e5" value="1:N" edge="1" parent="1" source="categoria" target="producto">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>